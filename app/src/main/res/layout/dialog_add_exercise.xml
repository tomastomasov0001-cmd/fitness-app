<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fadeScrollbars="false"
    android:scrollbarStyle="outsideOverlay">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/exercise_name"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/exerciseNameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/exercise_description"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/exerciseDescInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:minLines="2" />

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Typ záznamu:"
        android:textSize="14sp"
        android:textColor="@color/on_surface_secondary" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/hasSetsCheckbox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Série (více opakování cviku)"
        android:checked="true" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/setsInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:hint="@string/sets"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/defaultSetsInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:text="3" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/hasRepsCheckbox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Opakování (např. dřepy, kliky)"
        android:checked="true" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/hasWeightCheckbox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Váha (např. bench press, mrtvý tah)"
        android:checked="true" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/hasTimeCheckbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Čas (např. běh, plank)"
            android:checked="false" />

    </LinearLayout>

</ScrollView>
